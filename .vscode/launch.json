{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS (ESM)",
      "runtimeArgs": [
        "--loader",
        "ts-node/esm"
      ],
      "args": ["${workspaceFolder}/server.ts"],
      "sourceMaps": true,
      "env": {
        "TS_NODE_PROJECT": "tsconfig.json"
      }
    }
  ]
}